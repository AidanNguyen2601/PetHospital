@model Admission
@{
    var a = Model;
    ViewData["Title"] = a.Kind.GetDisplayName() + " " + a.Code; ViewData["Icon"] = "bed";
    var invoice = ViewBag.Invoice as Invoice;
    var active = a.Status == AdmissionStatus.Active;
}
<div class="d-flex flex-wrap gap-2 mb-3">
    @if (active)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.Id">@Icon("edit") Sửa / đổi chuồng</a>
        <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#dischargeBox">@Icon("logout") Xuất chuồng</button>
        <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="ms-auto" data-confirm="Hủy phiếu này (nhận nhầm)?"><button class="btn btn-sm btn-outline-danger">Hủy phiếu</button></form>
    }
    @if (invoice != null) { <a class="btn btn-sm btn-outline-primary" asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice.Id">@Icon("receipt") Hóa đơn @invoice.Code <span class="badge bg-@Badges.For(invoice.Status)">@invoice.Status.GetDisplayName()</span></a> }
</div>
@if (active)
{
    <div class="collapse mb-3" id="dischargeBox">
        <form asp-action="Discharge" asp-route-id="@a.Id" method="post" class="card card-body" data-confirm="Xác nhận xuất chuồng và lập hóa đơn?">
            <div class="mb-2">Tính tiền <b>@a.BillableDays() ngày</b> × @a.DailyRate.ToMoney() đ = <b>@((a.BillableDays() * a.DailyRate).ToMoney()) đ</b> (thuốc, dịch vụ điều trị lập hóa đơn riêng tại phiếu khám / bán hàng).</div>
            <label class="form-label">Tình trạng khi xuất</label>
            <textarea name="dischargeNote" class="form-control mb-2" rows="2" placeholder="VD: khỏe mạnh, ăn uống tốt; trả đủ đồ gửi kèm"></textarea>
            <div><button class="btn btn-primary">Xác nhận xuất chuồng</button></div>
        </form>
    </div>
}
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex gap-3 align-items-center mb-3">
                    <span class="pet-avatar lg @(a.Pet?.Species?.Name == "Mèo" ? "cat" : "")">@Icon("paw")</span>
                    <div><a asp-controller="Pets" asp-action="Details" asp-route-id="@a.PetId" class="fs-5 fw-bold">@a.Pet?.Name</a><div class="small text-muted">@a.Pet?.Species?.Name · @a.Owner?.FullName – @a.Owner?.Phone</div></div>
                </div>
                <dl class="info row mb-0 small">
                    <dt class="col-5">Trạng thái</dt><dd class="col-7"><span class="badge bg-@Badges.For(a.Status)">@a.Status.GetDisplayName()</span></dd>
                    <dt class="col-5">Chuồng</dt><dd class="col-7">@a.Cage?.Code – @a.Cage?.Name</dd>
                    <dt class="col-5">Bác sĩ phụ trách</dt><dd class="col-7">@a.Vet?.DisplayName</dd>
                    <dt class="col-5">Nhận lúc</dt><dd class="col-7">@a.AdmitAt.ToDateTime()</dd>
                    <dt class="col-5">Dự kiến xuất</dt><dd class="col-7">@a.ExpectedDischarge.ToDate()</dd>
                    <dt class="col-5">Xuất lúc</dt><dd class="col-7">@a.DischargeAt.ToDateTime()</dd>
                    <dt class="col-5">Số ngày</dt><dd class="col-7">@a.BillableDays()</dd>
                    <dt class="col-5">Giá / ngày</dt><dd class="col-7 money">@a.DailyRate.ToMoney()</dd>
                    <dt class="col-5">Lý do</dt><dd class="col-7">@a.Reason</dd>
                    <dt class="col-5">Lưu ý chăm sóc</dt><dd class="col-7">@a.CareNote</dd>
                    @if (!string.IsNullOrEmpty(a.DischargeNote)) { <dt class="col-5">Khi xuất</dt><dd class="col-7">@a.DischargeNote</dd> }
                </dl>
                @if (a.VisitId.HasValue) { <a class="small" asp-controller="Visits" asp-action="Details" asp-route-id="@a.VisitId">Xem phiếu khám gốc</a> }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Theo dõi hằng ngày</div>
            @if (active)
            {
                <form asp-action="AddNote" asp-route-id="@a.Id" method="post" class="card-body border-bottom row g-2">
                    <div class="col-md-2"><input name="temperature" type="number" step="0.1" class="form-control form-control-sm" placeholder="Nhiệt độ °C" /></div>
                    <div class="col-md-2"><input name="weightKg" type="number" step="0.01" class="form-control form-control-sm" placeholder="Cân nặng kg" /></div>
                    <div class="col-md-3"><input name="appetite" class="form-control form-control-sm" placeholder="Ăn uống" /></div>
                    <div class="col-md-5"><input name="note" class="form-control form-control-sm" placeholder="Diễn biến, tình trạng" /></div>
                    <div class="col-md-9"><input name="treatment" class="form-control form-control-sm" placeholder="Xử trí / thuốc đã dùng" /></div>
                    <div class="col-md-3 d-grid"><button class="btn btn-sm btn-primary">Ghi theo dõi</button></div>
                </form>
            }
            <div class="table-responsive">
                <table class="table table-sm mb-0" data-no-grid>
                    <thead><tr><th>Thời gian</th><th>Nhiệt độ</th><th>Cân nặng</th><th>Ăn uống</th><th>Diễn biến</th><th>Xử trí</th><th>Người ghi</th></tr></thead>
                    <tbody>
                        @foreach (var n in a.Notes.OrderByDescending(x => x.At))
                        {
                            <tr>
                                <td class="text-nowrap small">@n.At.ToString("HH:mm dd/MM")</td>
                                <td class="@(n.Temperature >= 39.5m ? "text-danger fw-semibold" : "")">@n.Temperature.ToQty()</td>
                                <td>@n.WeightKg.ToQty()</td>
                                <td class="small">@n.Appetite</td>
                                <td class="small">@n.Note</td>
                                <td class="small">@n.Treatment</td>
                                <td class="small text-muted">@n.User?.FullName</td>
                            </tr>
                        }
                        @if (a.Notes.Count == 0) { <tr><td colspan="7" class="text-muted small">Chưa có ghi chép.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
