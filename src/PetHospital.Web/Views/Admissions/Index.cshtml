@model PagedList<Admission>
@{
    ViewData["Title"] = "Nội trú / lưu chuồng"; ViewData["Icon"] = "bed";
    string tab = ViewBag.Tab;
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(tab == "board" ? "active" : "")" asp-route-tab="board">Sơ đồ chuồng</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "list" ? "active" : "")" asp-route-tab="list">Danh sách phiếu</a></li>
    <li class="nav-item ms-auto"><a class="btn btn-sm btn-primary" asp-action="Create">@Icon("plus") Nhận lưu chuồng / nằm viện</a></li>
</ul>
@if (tab == "board")
{
    var cages = (List<Cage>)ViewBag.Cages; var active = (List<Admission>)ViewBag.Active;
    <div class="small text-muted mb-2">@active.Count / @cages.Count chuồng đang sử dụng</div>
    <div class="cage-board">
        @foreach (var c in cages)
        {
            var a = active.FirstOrDefault(x => x.CageId == c.Id);
            <div class="cage @(a != null ? "busy" : "") @(c.IsIsolation ? "iso" : "")">
                <div class="d-flex justify-content-between"><span class="cage-code">@c.Code</span><span class="small text-muted">@c.Size @(c.IsIsolation ? "· cách ly" : "")</span></div>
                <div class="small text-muted mb-2">@c.Name</div>
                @if (a != null)
                {
                    <a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold">@a.Pet?.Name</a>
                    <div class="small">@a.Pet?.Species?.Name · @a.Owner?.FullName</div>
                    <div class="small text-muted">@a.Kind.GetDisplayName() · từ @a.AdmitAt.ToString("dd/MM HH:mm") (@a.BillableDays() ngày)</div>
                    if (a.ExpectedDischarge.HasValue) { <div class="small @(a.ExpectedDischarge < DateTime.Today ? "text-danger" : "text-muted")">Dự kiến xuất @a.ExpectedDischarge.ToDate()</div> }
                }
                else
                {
                    <a class="cage-empty small" asp-action="Create" asp-route-cageId="@c.Id">+ Trống – nhận thú cưng</a>
                }
            </div>
        }
    </div>
}
else
{
    var f = (ListFilter)ViewBag.Filter;
    <form method="get" class="toolbar">
        <input type="hidden" name="tab" value="list" />
        <input name="Q" value="@f.Q" class="form-control form-control-sm" style="max-width:280px" placeholder="Mã phiếu, thú cưng, chủ nuôi…" />
        <button class="btn btn-sm btn-outline-secondary">Tìm</button>
    </form>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Mã</th><th>Thú cưng</th><th>Chủ nuôi</th><th>Hình thức</th><th>Chuồng</th><th>Nhận</th><th>Xuất</th><th class="text-end">Số ngày</th><th>Trạng thái</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@a.Id">@a.Code</a></td>
                            <td>@a.Pet?.Name</td>
                            <td>@a.Owner?.FullName</td>
                            <td class="small">@a.Kind.GetDisplayName()</td>
                            <td>@a.Cage?.Code</td>
                            <td class="small text-nowrap">@a.AdmitAt.ToDateTime()</td>
                            <td class="small text-nowrap">@a.DischargeAt.ToDateTime()</td>
                            <td class="text-end">@(a.Status == AdmissionStatus.Cancelled ? "" : a.BillableDays().ToString())</td>
                            <td><span class="badge bg-@Badges.For(a.Status)">@a.Status.GetDisplayName()</span></td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0) { <tr><td colspan="9" class="text-muted p-3">Không có phiếu.</td></tr> }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white"><partial name="_Pager" model="Model" /></div>
    </div>
}
