@model List<Cage>
@{
    ViewData["Title"] = "Chuồng lưu trú"; ViewData["Icon"] = "home-heart";
    var busy = (List<int>)ViewBag.Busy; var canEdit = Me.HasAny(Perm.Catalog, Perm.Admission); string? branchName = ViewBag.BranchName;
}
<div class="toolbar">
    <a class="btn btn-sm btn-outline-secondary" asp-controller="Admissions" asp-action="Index">@Icon("bed") Sơ đồ chuồng</a>
    <span class="small text-muted">Chuồng của chi nhánh <b>@branchName</b> · @Model.Count(c => c.IsActive) chuồng đang sử dụng</span>
    @if (canEdit) { <a class="btn btn-sm btn-primary ms-auto" asp-action="Create">@Icon("plus") Thêm chuồng</a> }
</div>
<div class="card">
    <table class="table table-hover mb-0">
        <thead><tr><th>Mã</th><th>Tên / vị trí</th><th>Loại</th><th class="text-end">Giá / ngày</th><th>Tình trạng</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="@(c.IsActive ? "" : "text-muted")">
                    <td class="fw-semibold">@c.Code</td>
                    <td>@c.Name</td>
                    <td class="small">@c.Size @(c.IsIsolation ? "· cách ly" : "")</td>
                    <td class="text-end money">@c.DailyRate.ToMoney()</td>
                    <td>@if (!c.IsActive) { <span class="badge bg-secondary">Ngừng sử dụng</span> } else if (busy.Contains(c.Id)) { <span class="badge bg-primary">Đang có thú</span> } else { <span class="badge bg-success">Trống</span> }</td>
                    <td class="text-end text-nowrap">
                        @if (canEdit)
                        {
                            <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@c.Id">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Xóa chuồng này?"><button class="btn btn-sm btn-link text-danger">Xóa</button></form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
