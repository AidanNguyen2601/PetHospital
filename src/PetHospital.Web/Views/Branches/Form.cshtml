@model Branch
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm chi nhánh" : "Sửa chi nhánh " + Model.Code; ViewData["Icon"] = "building";
}
<form asp-action="Save" method="post" class="card" style="max-width:820px">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control text-uppercase" maxlength="6" placeholder="Q7, TD..." />
                <span asp-validation-for="Code" class="text-danger small"></span>
                <div class="small text-muted">Tiền tố số chứng từ</div>
            </div>
            <div class="col-md-9"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="PetCare Quận 7" /><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
            <div class="col-md-5"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="col-md-3"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" type="number" class="form-control" /></div>
            <div class="col-12">
                <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
                <span asp-validation-for="IsActive" class="text-danger small"></span>
            </div>
        </div>
        <div class="small text-muted mt-3">Địa chỉ, điện thoại in trên hóa đơn, đơn thuốc, phiếu nhập kho của chi nhánh (để trống thì dùng thông tin chung của công ty).</div>
    </div>
    <div class="card-footer bg-white d-flex gap-2"><button class="btn btn-primary">Lưu</button><a class="btn btn-light" asp-action="Index">Hủy</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
