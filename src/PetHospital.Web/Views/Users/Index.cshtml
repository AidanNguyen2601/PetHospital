@model PagedList<AppUser>
@{
    ViewData["Title"] = "Người dùng"; ViewData["Icon"] = "users";
    var f = (ListFilter)ViewBag.Filter; string? role = ViewBag.Role;
}
<form method="get" class="toolbar">
    <input name="Q" value="@f.Q" class="form-control form-control-sm" style="max-width:240px" placeholder="Tên đăng nhập, họ tên, email…" />
    <select name="role" class="form-select form-select-sm" style="max-width:220px" onchange="this.form.submit()">
        <option value="">-- Tất cả vai trò --</option>
        @foreach (var r in AppRoles.All) { <option value="@r.Code" selected="@(r.Code == role)">@r.Name</option> }
    </select>
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
    <a class="btn btn-sm btn-primary ms-auto" asp-action="Create">@Icon("plus") Thêm người dùng</a>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Vai trò</th><th>Điện thoại / email</th><th>Đăng nhập gần nhất</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr class="@(u.IsActive ? "" : "text-muted")">
                        <td><a asp-action="Edit" asp-route-id="@u.Id" class="fw-semibold">@u.Username</a></td>
                        <td>@u.DisplayName @if (u.IsVet) { <span class="badge bg-info text-dark">Bác sĩ</span> }</td>
                        <td class="small">@(string.Join(", ", u.RoleList().Select(AppRoles.DisplayName)))</td>
                        <td class="small">@u.Phone<div class="text-muted">@u.Email</div></td>
                        <td class="small">@u.LastLoginAt.ToDateTime()</td>
                        <td>@if (u.IsActive) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Đã khóa</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white"><partial name="_Pager" model="Model" /></div>
</div>
