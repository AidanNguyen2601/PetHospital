@model ReportTable
@{
    var rp = (ReportPage)ViewBag.Page;
    ViewData["Title"] = rp.Name; ViewData["Icon"] = rp.Icon;
    var print = ViewData["Layout"] as string == "_PrintLayout";
}
@if (print)
{
    <partial name="_PrintHeader" model="@(Context.RequestServices.GetRequiredService<SettingsService>())" />
    <h4 class="text-center fw-bold my-2 text-uppercase">@Model.Title</h4>
    <div class="text-center small mb-3">@Model.Subtitle</div>
}
else
{
    <form method="get" class="toolbar align-items-center">
        <a class="btn btn-sm btn-light" asp-action="Index">&laquo; Danh sách báo cáo</a>
        <partial name="_ReportScope" model="rp" />
        @if (rp.Dated) { <button class="btn btn-sm btn-outline-secondary">Xem</button> }
        <partial name="_ReportExport" />
    </form>
    <div class="small text-muted mb-2">@Model.Subtitle</div>
    @if (Model.Chart != null && Model.Chart.Count > 0)
    {
        <div class="card mb-3"><div class="card-body"><partial name="_BarChart" model="@(new BarChartModel(Model.Chart, rp.ChartMoney))" /></div></div>
    }
}
<partial name="_ReportTable" model="Model" />
