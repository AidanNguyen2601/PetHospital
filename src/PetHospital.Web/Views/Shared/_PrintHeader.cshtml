@* Đầu biểu mẫu in: thông tin phòng khám *@
@model SettingsService
<table class="w-100 mb-2 print-head">
    <tr>
        <td style="width:60%">
            <div class="fw-bold text-uppercase" style="font-size:1.05rem">@await Model.GetAsync(SettingsService.ClinicName)</div>
            <div class="small">@await Model.GetAsync(SettingsService.ClinicAddress)</div>
            <div class="small">ĐT: @await Model.GetAsync(SettingsService.ClinicPhone) · @await Model.GetAsync(SettingsService.ClinicEmail)</div>
            @{ var tax = await Model.GetAsync(SettingsService.ClinicTaxCode); }
            @if (!string.IsNullOrEmpty(tax)) { <div class="small">MST: @tax</div> }
        </td>
        <td class="text-end align-top small text-muted">In lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</td>
    </tr>
</table>
