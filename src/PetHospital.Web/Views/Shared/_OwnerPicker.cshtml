@model OwnerPickerModel
<div class="owner-picker" data-owner-picker data-target="@Model.HiddenSelector" data-pets="@Model.PetSelectSelector" data-weight="@Model.WeightSelector">
    <input type="text" class="form-control" value="@Model.Text" placeholder="Gõ tên hoặc số điện thoại khách hàng…" autocomplete="off" />
    <div class="picker-results"></div>
</div>
