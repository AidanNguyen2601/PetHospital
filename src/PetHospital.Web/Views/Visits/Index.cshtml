@model PagedList<Visit>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Khám bệnh"; ViewData["Icon"] = "stethoscope";
    string tab = ViewBag.Tab; var f = (ListFilter)ViewBag.Filter; DateTime? from = ViewBag.From, to = ViewBag.To; int queueCount = ViewBag.QueueCount;
    var no = (Model.Page - 1) * Model.PageSize;
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(tab == "queue" ? "active" : "")" asp-route-tab="queue">Hàng chờ khám <span class="badge bg-primary">@queueCount</span></a></li>
    <li class="nav-item"><a class="nav-link @(tab == "all" ? "active" : "")" asp-route-tab="all">Tra cứu phiếu khám</a></li>
    @if (Me.HasAny(Perm.Appointment, Perm.VisitExam)) { <li class="nav-item ms-auto"><a class="btn btn-sm btn-primary" asp-action="Create">@Icon("plus") Tiếp nhận khách vãng lai</a></li> }
</ul>
<form method="get" class="toolbar">
    <input type="hidden" name="tab" value="@tab" />
    <input name="Q" value="@f.Q" class="form-control form-control-sm" style="max-width:260px" placeholder="Mã phiếu, thú cưng, chủ nuôi, chẩn đoán…" />
    <select name="vetId" class="form-select form-select-sm" style="max-width:220px" asp-items="@((List<SelectListItem>)ViewBag.Vets)"></select>
    @if (tab == "all")
    {
        <input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="max-width:150px" />
        <input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="max-width:150px" />
    }
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Phiếu khám</th><th>Thú cưng</th><th>Chủ nuôi</th><th>Lý do / chẩn đoán</th><th>Bác sĩ</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in Model.Items)
                {
                    no++;
                    <tr>
                        <td class="text-muted">@no</td>
                        <td><a asp-action="Details" asp-route-id="@v.Id">@v.Code</a><div class="small text-muted">@v.VisitAt.ToString("HH:mm dd/MM")</div></td>
                        <td><a asp-controller="Pets" asp-action="Details" asp-route-id="@v.PetId" class="fw-semibold">@v.Pet?.Name</a> <span class="small text-muted">@v.Pet?.Species?.Name</span>
                            @if (!string.IsNullOrEmpty(v.Pet?.Allergies)) { <span class="allergy ms-1" title="@v.Pet.Allergies">Dị ứng</span> }</td>
                        <td>@v.Owner?.FullName<div class="small text-muted">@v.Owner?.Phone</div></td>
                        <td class="small">@v.Reason<div class="text-muted">@v.Diagnosis</div></td>
                        <td class="small">@v.Vet?.DisplayName</td>
                        <td><span class="badge bg-@Badges.For(v.Status)">@v.Status.GetDisplayName()</span></td>
                        <td class="text-end text-nowrap">
                            @if (v.Status is VisitStatus.Waiting or VisitStatus.InProgress && Me.Has(Perm.VisitExam))
                            {
                                <form asp-action="Start" asp-route-id="@v.Id" method="post" class="d-inline"><button class="btn btn-sm btn-primary">@(v.Status == VisitStatus.Waiting ? "Bắt đầu khám" : "Tiếp tục khám")</button></form>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@v.Id">Xem</a>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-muted p-3">@(tab == "queue" ? "Không có thú cưng nào đang chờ khám." : "Không có phiếu khám.")</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white"><partial name="_Pager" model="Model" /></div>
</div>
