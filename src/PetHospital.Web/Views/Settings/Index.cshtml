@model Dictionary<string, string>
@{
    ViewData["Title"] = "Thông tin phòng khám & tham số"; ViewData["Icon"] = "settings";
}
<form asp-action="Save" method="post" class="card" style="max-width:820px">
    <div class="card-body">
        <div class="small text-muted mb-3">Thông tin này in trên hóa đơn, đơn thuốc, phiếu nhập kho và báo cáo.</div>
        @foreach (var (key, label, _) in SettingsService.All)
        {
            <div class="mb-3">
                <label class="form-label" for="@key.Replace(".", "_")">@label</label>
                @if (key == SettingsService.InvoiceFooter || key == SettingsService.ClinicAddress)
                {
                    <textarea class="form-control" name="@key" id="@key.Replace(".", "_")" rows="2">@Model[key]</textarea>
                }
                else
                {
                    <input class="form-control" name="@key" id="@key.Replace(".", "_")" value="@Model[key]" type="@(key.StartsWith("Remind.") || key.StartsWith("Stock.") ? "number" : "text")" />
                }
            </div>
        }
    </div>
    <div class="card-footer bg-white"><button class="btn btn-primary">Lưu</button></div>
</form>
