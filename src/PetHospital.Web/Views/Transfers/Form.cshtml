@model TransferFormModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Lập phiếu chuyển kho" : "Sửa phiếu chuyển kho " + ViewBag.Code; ViewData["Icon"] = "transfer";
    var productList = (List<Product>)ViewBag.ProductList;
    var branches = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Branches;
    var lines = Model.Lines.Count > 0 ? Model.Lines : new List<TransferLineInput> { new() };
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger small py-2" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
    @if (branches.Count == 0)
    {
        <div class="alert alert-warning">Chưa có chi nhánh nào khác đang hoạt động để chuyển kho. Thêm chi nhánh tại Quản trị › Chi nhánh.</div>
    }
    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3"><label class="form-label">Chi nhánh xuất</label><input class="form-control" value="@ViewBag.FromBranch" disabled /></div>
            <div class="col-md-3">
                <label asp-for="ToBranchId" class="form-label"></label>
                <select asp-for="ToBranchId" class="form-select" asp-items="branches"><option value="0">-- Chọn chi nhánh nhận --</option></select>
                <span asp-validation-for="ToBranchId" class="text-danger small"></span>
            </div>
            <div class="col-md-2"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" /></div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">Hàng chuyển <span class="small text-muted">· xuất theo lô hạn dùng gần nhất trước, giữ nguyên số lô / hạn dùng / giá vốn khi nhập vào chi nhánh nhận</span></div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 lines-table" data-no-grid>
                <thead><tr><th style="width:60%">Mặt hàng (tồn tại chi nhánh xuất)</th><th style="width:18%">Số lượng</th><th></th></tr></thead>
                <tbody id="tfRows" data-rows="Lines">
                    @foreach (var l in lines)
                    {
                        <tr class="row-item">
                            <td>
                                <select data-f="ProductId" class="form-select form-select-sm">
                                    <option value="">-- Chọn mặt hàng --</option>
                                    @foreach (var g in productList.GroupBy(p => p.Kind))
                                    {
                                        <optgroup label="@g.Key.GetDisplayName()">
                                            @foreach (var p in g)
                                            {
                                                <option value="@p.Id" selected="@(p.Id == l.ProductId)" disabled="@(p.Stock <= 0 && p.Id != l.ProductId)">@p.Code – @p.Name (tồn @p.Stock.ToQty() @p.Unit)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </td>
                            <td><input data-f="Quantity" type="number" step="0.001" min="0" class="form-control form-control-sm" value="@l.Quantity.ToString(inv)" data-default="1" /></td>
                            <td><button type="button" class="btn btn-sm btn-link text-danger remove" title="Xóa dòng">@Icon("x")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white"><button type="button" class="btn btn-sm btn-outline-primary" data-add-row="#tfRows">@Icon("plus") Thêm dòng</button></div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" name="command" value="post" data-confirm="Ghi sổ phiếu chuyển kho? Tồn kho chi nhánh xuất bị trừ và cộng vào chi nhánh nhận ngay.">@Icon("check") Lưu &amp; ghi sổ</button>
        <button class="btn btn-outline-primary" name="command" value="draft">Lưu nháp</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>
