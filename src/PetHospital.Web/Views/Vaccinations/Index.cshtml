@model PagedList<Vaccination>
@{
    ViewData["Title"] = "Tiêm phòng & nhắc lịch"; ViewData["Icon"] = "syringe";
    string tab = ViewBag.Tab; int days = ViewBag.Days; var f = (ListFilter)ViewBag.Filter;
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(tab == "due" ? "active" : "")" asp-route-tab="due">Cần nhắc lịch</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "all" ? "active" : "")" asp-route-tab="all">Sổ tiêm (tất cả)</a></li>
</ul>
<form method="get" class="toolbar">
    <input type="hidden" name="tab" value="@tab" />
    <input name="Q" value="@f.Q" class="form-control form-control-sm" style="max-width:260px" placeholder="Vắc-xin, thú cưng, chủ nuôi, SĐT…" />
    @if (tab == "due")
    {
        <label class="small text-muted">Đến hạn trong</label>
        <input type="number" name="days" value="@days" min="0" max="365" class="form-control form-control-sm" style="max-width:80px" />
        <span class="small text-muted">ngày (gồm cả quá hạn)</span>
    }
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
    <a class="btn btn-sm btn-outline-secondary ms-auto" asp-route-tab="@tab" asp-route-days="@days" asp-route-q="@f.Q" asp-route-export="xlsx">@Icon("download") Excel (danh sách gọi điện)</a>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Thú cưng</th><th>Chủ nuôi</th><th>Vắc-xin</th><th>Mũi</th><th>Ngày tiêm</th><th>Hẹn mũi tiếp</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in Model.Items)
                {
                    var overdue = v.NextDueDate.HasValue && v.NextDueDate < DateTime.Today && !v.ReminderDone;
                    <tr>
                        <td><a asp-controller="Pets" asp-action="Details" asp-route-id="@v.PetId" class="fw-semibold">@v.Pet?.Name</a> <span class="small text-muted">@v.Pet?.Species?.Name</span></td>
                        <td>@v.Pet?.Owner?.FullName<div class="small"><a href="tel:@v.Pet?.Owner?.Phone">@v.Pet?.Owner?.Phone</a></div></td>
                        <td>@v.VaccineName</td>
                        <td>@v.DoseNumber</td>
                        <td class="text-nowrap">@v.Date.ToDate()</td>
                        <td class="text-nowrap">
                            @if (v.NextDueDate.HasValue)
                            {
                                <span class="badge bg-@(v.ReminderDone ? "light text-muted border" : overdue ? "danger" : "warning text-dark")">@v.NextDueDate.ToDate()</span>
                                if (overdue) { <div class="small text-danger">Quá hạn @((DateTime.Today - v.NextDueDate.Value).Days) ngày</div> }
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (tab == "due")
                            {
                                if (Me.HasAny(Perm.Appointment)) { <a class="btn btn-sm btn-primary" asp-controller="Appointments" asp-action="Create" asp-route-petId="@v.PetId" asp-route-at="@(v.NextDueDate!.Value < DateTime.Today ? "" : v.NextDueDate.Value.AddHours(9).ToString("yyyy-MM-ddTHH:mm"))">Đặt lịch</a> }
                                <form asp-action="MarkDone" asp-route-id="@v.Id" method="post" class="d-inline" data-confirm="Đánh dấu đã nhắc / khách đã tiêm nơi khác?"><button class="btn btn-sm btn-light">Đã nhắc</button></form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-muted p-3">Không có dữ liệu.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white"><partial name="_Pager" model="Model" /></div>
</div>
