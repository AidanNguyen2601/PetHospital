# Copy thành .env rồi sửa. Chọn port KHÔNG trùng các sản phẩm khác (HRM 8090, CRM 8100, E-Proc 8110, PM 8120, ERP 8130, DMS 8140, EAM 8150)
PET_WEB_PORT=8160
PET_DB_PORT=1441
PET_SA_PASSWORD=Pet@Strong2026
# Nạp dữ liệu mẫu khi database còn trống (true/false)
PET_SEED_SAMPLE=true

# ---- Phương án B: dùng chung SQL Server đang có (script deploy-pet-shared-db.ps1 tự điền) ----
SHARED_NETWORK=healthtracker_default
SHARED_DB_HOST=healthtracker-db
SHARED_DB_USER=pet_app
SHARED_DB_PASSWORD=ChangeMe@123

# Bao cao dong: chuoi ket noi SQL chi doc (db_datareader), de trong = dung ket noi chinh
PET_REPORT_CONNECTION=
